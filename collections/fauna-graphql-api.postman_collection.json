    {
      "id": "5f3a871f-73a8-4460-a969-0e3c84d7a40f",
      "name": "Schema",
      "description": {
        "content": "Import and manage GraphQL schemas. Fauna auto-generates collections, indexes, and resolvers from the uploaded schema.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "9b36dabc-493c-45b3-93ed-2ebd12569980",
          "name": "Import a GraphQL schema",
          "request": {
            "name": "Import a GraphQL schema",
            "description": {
              "content": "Imports a GraphQL schema definition into the authenticated Fauna database. Fauna automatically creates collections, indexes, and resolvers based on the schema types and relationships. Use mode parameter to control whether to merge with or replace the existing schema.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "import"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "mode",
                  "value": "merge",
                  "description": "Schema import mode. Use merge to add to the existing schema or replace to overwrite it entirely. Override allows updating existing types."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "schema",
                  "type": "file",
                  "description": "GraphQL schema file to import."
                }
              ]
            }
          },
          "response": [
            {
              "id": "d51be9ed-3895-49cf-a99b-c6014f315569",
              "name": "Schema imported successfully",
